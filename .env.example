# The reasoning layer in app/reasoning/ calls the OpenAI API directly through
# the plain SDK. No agentic framework is involved - see requirements.txt.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Where the fine-tuned RT-DETR weights live. See README for the download link.
MODEL_PATH=./weights/best.pt

# Reject uploads larger than this. Document scans are rarely above a few MB,
# so this is generous and still stops someone posting a 2 GB file at the API.
MAX_UPLOAD_MB=10
